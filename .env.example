# Example configuration file
# Rename to .env and insert your specific values

# --- Operational Settings ---
# Check interval in seconds (Default: 86400 = 24 hours)
CHECK_INTERVAL=86400
# Optional: Run Watcher once daily at this specific local time (e.g. 03:00)
# SCHEDULE_TIME=03:00
DRY_RUN=false
CLEANUP_OLD_IMAGES=false
# Standard output log level. Can be set to DEBUG for extensive troubleshooting.
LOG_LEVEL=INFO

# --- 1.6.0 New Features: Cooldown & Journal ---
# Seconds to wait before retrying a container that failed multiple times.
FAILURE_COOLDOWN_SECONDS=3600
# How many consecutive failures are allowed before entering cooldown.
MAX_RETRIES_BEFORE_COOLDOWN=1
# Enable local JSON journaling of all scan cycles.
JOURNAL_ENABLED=true
# Path to the journal file.
JOURNAL_PATH=journal.json
# Maximum number of cycle entries to keep in the journal.
JOURNAL_MAX_ENTRIES=100

# --- Advanced Operational Toggles ---
# Maximum number of containers to update in a single cycle (0 = unlimited).
MAX_UPDATES_PER_CYCLE=0
# If false, Watcher will not restart dependent containers.
RESTART_DEPENDENTS=true
# If false, suppresses the "Watcher Started" notification.
NOTIFY_ON_STARTUP=true

# --- Notifications (Configure at least one) ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=123456789:ABCDefg...
# TELEGRAM_CHAT_ID=-1001234567890
# NTFY_URL=https://ntfy.sh/mytopic

# If false, suppresses "Updates Available" alerts in summary reports for watcher.enable=false containers.
NOTIFY_UPDATES_AVAILABLE=true
# If false, suppresses the "Initiating sequence" notification at the start of an update.
NOTIFY_ON_UPDATE_START=true
# Strategy for sending summary reports: always, on_change, or on_error.
NOTIFY_SUMMARY_STRATEGY=always

# --- Auto-Update Strategy (Hybrid Mode) ---
# If WATCH_BY_LABEL is true: Only containers with 'watcher.enable=true' are auto-updated.
# All other containers are monitored for updates and reported, but NOT auto-updated.
# If WATCH_BY_LABEL is false: All containers are auto-updated unless they have 'watcher.enable=false' or are explicitly excluded.
# Containers with 'watcher.self=true' are always ignored entirely.
WATCH_BY_LABEL=true

# --- Advanced Exclusion ---
# Comma-separated list of container names to ignore entirely.
# EXCLUDE_CONTAINER_NAMES=mysql,redis
# Regex pattern to ignore containers by name.
# EXCLUDE_CONTAINER_REGEX=^test_.*

# --- Health Check Configuration ---
# Heavy containers (like Postgres, Nextcloud, GitLab) can take 60-120 seconds to start.
# Default gives them ~120s (12 retries * 10s delay) to become healthy before rollback.
HEALTH_CHECK_RETRIES=12
HEALTH_CHECK_DELAY=10

# --- Optional Registry Auth ---
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
