# Example configuration file
# Rename to .env and insert your specific values

# Required: The Discord Webhook URL for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional Operational Settings
CHECK_INTERVAL=300
DRY_RUN=false
CLEANUP_OLD_IMAGES=false

# Optional Registry Auth
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
